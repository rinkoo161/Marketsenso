# MarketSense configuration — copy to .env and edit.
# Every value here has a working default for local dev; the app runs with an
# empty .env on a machine with brew postgresql@16 and a trust-auth local user.

# --- database ---------------------------------------------------------------
MS_DB_URL=postgresql+psycopg://localhost:5432/marketsense
MS_DB_URL_TEST=postgresql+psycopg://localhost:5432/marketsense_test

# --- NSE politeness budget --------------------------------------------------
# Hard per-minute ceiling across ALL agents in the ingest process. The token
# bucket refuses (does not queue) when exhausted; agents skip the cycle.
MS_NSE_BUDGET_PER_MIN=30
# Consecutive 401/403s before the circuit breaker opens.
MS_NSE_BREAKER_THRESHOLD=2
# Seconds the breaker stays open before a single probe is allowed.
MS_NSE_BREAKER_COOLDOWN=180

# --- storage ----------------------------------------------------------------
# PDFs and raw payloads. Object store = plain directory in Phase 1.
MS_DATA_DIR=~/.marketsense

# --- LLM (Phase 2 — unused in Phase 1, registered now so config is stable) --
MS_AI_ENGINE=local            # local | online | auto | off
MS_OLLAMA_URL=http://localhost:11434
MS_OLLAMA_MODEL=qwen2.5:3b
# ANTHROPIC_API_KEY=           # only needed for online/auto

# --- api --------------------------------------------------------------------
MS_API_HOST=127.0.0.1
MS_API_PORT=8100              # ltp-monitor owns 8000; do not collide
